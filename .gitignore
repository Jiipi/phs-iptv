# Gradle
.gradle/
/build/
app/build/
**/build/

# Local machine config — mỗi máy tự tạo lại từ local.properties.example
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
.DS_Store
captures/
.externalNativeBuild/
.cxx/


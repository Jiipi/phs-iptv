<?xml version="1.0" encoding="utf-8"?>
<!-- TV launcher banner (320×180dp). Replace with branded PNG when available. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/midnight_navy" />
        </shape>
    </item>
    <!-- Gold accent strip at bottom -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_gold" />
            <size android:height="6dp" />
        </shape>
    </item>
</layer-list>
